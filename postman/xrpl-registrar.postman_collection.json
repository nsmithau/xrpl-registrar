              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "IOU variant: identify the issuance by `currency` + `issuer` instead of `mpt_issuance_id`. Filters are the same (`account`, ledger range, or date range)."
          },
          "event": [
