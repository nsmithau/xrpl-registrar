{
  "info": {
    "_postman_id": "b1e7a3c2-9d84-4f16-8a0e-7c5f2d3a1b90",
    "name": "XRPL Registrar",
    "description": "Admin API and tool-specific reporting endpoints for a self-hosted XRPL filtered-archive registrar.\n\nTwo ports:\n- Read API (`readUrl`, default http://127.0.0.1:51234) — public, Clio-compatible + `archive_*` reporting extensions.\n- Admin API (`adminUrl`, default http://127.0.0.1:51235) — authenticated with `adminToken`; also serves the read-only dashboard at `/`.\n\nSetup: set `adminToken` to your ADMIN_TOKEN, and set `mptIssuanceId` / `account` (or `currency` + `issuer`) to real values. Typical flow: Admin → Register issuance (saves `issuanceId`) → Get issuance status until backfill completes → Reporting extensions.\n\n`api_version: 2` is required on every read-API call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Admin API (authenticated)",
      "description": "Operator control surface on the admin port (default 51235). Requires `Authorization: Bearer {{adminToken}}` (set from your ADMIN_TOKEN). Registering an issuance triggers discovery + backfill + derivation in the background. Never expose this port publicly.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Register MPT issuance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances"]
            },
            "description": "Register an MPT issuance by its 48-hex MPTokenIssuanceID. `backfillFromLedger` is optional. On success returns 201 `{ issuance }`; this request saves the new id into the `issuanceId` variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"mpt\",\n  \"mptIssuanceId\": \"{{mptIssuanceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registered (201)', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.issuance && j.issuance.id != null) {",
                  "  pm.collectionVariables.set('issuanceId', j.issuance.id);",
                  "  console.log('issuanceId =', j.issuance.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register IOU issuance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances"]
            },
            "description": "Register an IOU issuance by currency + issuer account. `backfillFromLedger` is optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"iou\",\n  \"currency\": \"{{currency}}\",\n  \"issuer\": \"{{issuer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('registered (201)', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "List issuances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances"]
            },
            "description": "List every configured issuance. Response also carries `latestLedger` (where the live tail is) and `activity` — the live backfill/discovery indicators shown on the dashboard."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get issuance status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances/{{issuanceId}}",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances", "{{issuanceId}}"]
            },
            "description": "Full status for one issuance: account count, transactions archived, latest ledger, backfill job summary, coverage range, and the last reconciliation result."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Pause issuance",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances/{{issuanceId}}",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances", "{{issuanceId}}"]
            },
            "description": "Pause an issuance. The account set is append-only and is never pruned; pausing only stops further work.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resume issuance",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances/{{issuanceId}}",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances", "{{issuanceId}}"]
            },
            "description": "Re-enable a paused issuance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete issuance",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{adminUrl}}/admin/issuances/{{issuanceId}}",
              "host": ["{{adminUrl}}"],
              "path": ["admin", "issuances", "{{issuanceId}}"]
            },
            "description": "Delete an issuance and purge the data exclusively its own (deltas, jobs, and the accounts/transactions no other issuance references), then VACUUM to reclaim disk. Data shared with another issuance is retained. The deliberate exception to the archive's append-only design (ADR-018) — for a mistaken registration or an abandoned mega-issuer sweep, not regulatory redaction. While a delete + vacuum runs, other mutating admin calls return 409. Returns a summary { accountsRemoved, transactionsRemoved, deltasRemoved, compacted }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200) or not found (404)', () => pm.expect([200, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reporting extensions (archive_*)",
      "description": "Namespaced reporting methods unique to this tool — Clio has no equivalent. Served from the public read API (default 51234) over HTTP JSON-RPC. Balances/deltas are computed exactly (integer for MPT, decimal for IOU). `api_version: 2` is required. Identify the issuance by `mpt_issuance_id`, or by `currency` + `issuer` for an IOU. Identify the issuance by mpt_issuance_id, by currency + issuer (IOU), or by the archive's local issuance_id (uniform across MPT and IOU; instance-local, so prefer the ledger-native identifiers for anything that must be portable).",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "archive_balance_at — by ledger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_balance_at\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"account\": \"{{account}}\",\n      \"ledger_index\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "An account's balance in an issuance as of a ledger index (sum of its deltas up to and including that ledger). Warns if the ledger exceeds the account's coverage."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_balance_at — by date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_balance_at\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"account\": \"{{account}}\",\n      \"date\": \"2026-03-01T00:00:00Z\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Same, but resolve the point in time from an ISO `date`: the balance as of the ledger in effect at or before that instant. Requires ledger close times to have been captured."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_balance_at — by issuance_id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_balance_at\",\n  \"params\": [\n    {\n      \"issuance_id\": \"{{issuanceId}}\",\n      \"account\": \"{{account}}\",\n      \"ledger_index\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Identify the issuance by its local numeric id (as shown by the admin API/dashboard) — the same request shape for MPT and IOU. issuance_id is instance-local; use mpt_issuance_id or currency+issuer for portable/reproducible queries."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_balance_at — IOU (currency + issuer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_balance_at\",\n  \"params\": [\n    {\n      \"currency\": \"{{currency}}\",\n      \"issuer\": \"{{issuer}}\",\n      \"account\": \"{{account}}\",\n      \"ledger_index\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "An IOU holder's balance as of a ledger, identified by currency + issuer. Currency accepts the readable code (USD, RLUSD) or the 40-hex form."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_transactions — by account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_transactions\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"account\": \"{{account}}\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Every balance-changing transaction for one account of an issuance. With no range the bounds default to `[0, latest]` (all history). One `transactions[]` entry per (transaction, account): `account`, signed `delta`, `ledger`, `hash`, oldest first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_transactions — by ledger range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_transactions\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"from_ledger\": 19000000,\n      \"to_ledger\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Balance-changing transactions for an issuance over `[from_ledger, to_ledger]` (`to_ledger` may be `\"validated\"` = the archive's latest ledger). Add `account` to scope to one holder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "archive_transactions — by date range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"archive_transactions\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"from_time\": \"2026-01-01T00:00:00Z\",\n      \"to_time\": \"2026-04-01T00:00:00Z\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Same, but the range is given as ISO `from_time` / `to_time`, each resolved to the ledger in effect at that time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok (200)', () => pm.response.to.have.status(200));",
                  "pm.test('success', () => pm.expect(pm.response.json().result.status).to.eql('success'));"
                ]
