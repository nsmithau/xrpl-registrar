    },
    {
      "name": "Archive reads (Clio-compatible)",
      "description": "These mirror Clio's own request/response shapes exactly — they are NOT specific to this tool, so any existing Clio/xrpl.js client or Postman collection works against the read port too. Included here as a convenience and to demonstrate the fail-closed scope behaviour (out-of-scope reads return `notInArchive`, never `actNotFound` or a plausible empty result).",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "mpt_holders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"mpt_holders\",\n  \"params\": [\n    {\n      \"mpt_issuance_id\": \"{{mptIssuanceId}}\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Current holders of an MPT from the archive, scope-checked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "gateway_balances — IOU issuer obligations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"gateway_balances\",\n  \"params\": [\n    {\n      \"account\": \"{{issuer}}\",\n      \"ledger_index\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Total obligations (tokens in circulation) per registered IOU currency of an issuer, as of a ledger (`ledger_index` defaults to the archive's latest; accepts a number or \"validated\"). The IOU analogue of `mpt_holders`. Fail-closed: an issuer with no tracked IOU returns `notInArchive`; a ledger outside coverage returns `outOfCoverage`. `assets` is out of scope and omitted (warning 65004)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "gateway_balances — with a hot wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"gateway_balances\",\n  \"params\": [\n    {\n      \"account\": \"{{issuer}}\",\n      \"hotwallet\": [\"{{account}}\"],\n      \"ledger_index\": \"validated\",\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "Same, with one or more `hotwallet` accounts broken out of `obligations` into a separate `balances` map (accepts a single address or an array), matching Clio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "account_tx",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"account_tx\",\n  \"params\": [\n    {\n      \"account\": \"{{account}}\",\n      \"ledger_index_min\": -1,\n      \"ledger_index_max\": -1,\n      \"binary\": false,\n      \"limit\": 20,\n      \"api_version\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{readUrl}}/",
              "host": ["{{readUrl}}"],
              "path": [""]
            },
            "description": "An in-scope account's transaction history from the archive, with honest coverage bounds. Out-of-scope accounts fail closed with `notInArchive`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('ok (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ],
