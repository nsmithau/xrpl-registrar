{
  "name": "xrpl-registrar",
  "version": "0.1.0",
  "description": "Open-source, self-hosted XRPL transaction archive scoped to token issuances, sourced from Clio.",
  "license": "ISC",
  "author": "nsmithau (https://github.com/nsmithau)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsmithau/xrpl-registrar.git"
  },
  "homepage": "https://github.com/nsmithau/xrpl-registrar#readme",
  "bugs": {
    "url": "https://github.com/nsmithau/xrpl-registrar/issues"
  },
  "keywords": [
    "xrpl",
    "clio",
    "xrpld",
    "archive",
    "registrar",
    "mpt",
    "iou"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "demo": "tsx --env-file-if-exists=.env examples/mpt-demo.ts",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe": "tsx --env-file-if-exists=.env examples/probe-ratelimit.ts",
    "verify": "tsx --env-file-if-exists=.env examples/verify-balances.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "big.js": "^7.0.1",
    "ws": "^8.21.3",
    "xrpl": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "lucide-static": "^1.38.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
