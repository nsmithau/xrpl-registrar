# Copy to .env and adjust. All configuration is read from the environment.

# --- Upstream Clio (required) ---
# WebSocket URL of a FULL-HISTORY Clio server. No default: a missing or wrong
# source is an error, never a silent fallback.
CLIO_ENDPOINT=wss://your-full-history-clio.example

# Optional: Clio HTTP JSON-RPC endpoint. When set, the heavy paged account_tx
# backfill/heal workload uses it — a connection pool parallelises far better than
# the single WebSocket socket, where large binary pages head-of-line-block
# (ADR-016). The subscribe tail and forwarding stay on CLIO_ENDPOINT. Leave unset
# to run everything over WebSocket.
# CLIO_HTTP_ENDPOINT=https://your-full-history-clio.example:51234/

# Retries per request on upstream load signals (slowDown, disconnects).
CLIO_MAX_RETRIES=5
# WebSocket connection timeout, in milliseconds.
CLIO_CONNECTION_TIMEOUT_MS=20000
# Per-request timeout, in milliseconds. Generous by design: a heavy account_tx
# page can take several seconds, so a short timeout would spuriously fail
# slow-but-valid requests and drive needless backoff.
CLIO_REQUEST_TIMEOUT_MS=30000

# --- Storage (in-process Postgres / PGlite) ---
# Filesystem directory for the embedded database. Leave unset for an ephemeral
# in-memory database (data is lost on exit). A persistent archive MUST set this.
DATABASE_DIR=./data

# --- Server (pnpm serve) ---
# Port for the public read API (WebSocket + HTTP JSON-RPC).
PORT=51234
# serve never auto-ingests; register issuances via the admin API. The guided
# testnet tour that ingests a sample issuance is `pnpm demo`.
# Safety-net full re-scan interval, in milliseconds. New holders are discovered
# live from the tail (via the issuer subscription) AND during gap heals, so this
# full trustline re-scan is now a pure backstop — it also adds upstream/CPU load
# each pass. Set 0 to disable it (recommended once you trust streaming); raise it
# for a rare belt-and-suspenders check. Default 1 hour.
REDISCOVERY_INTERVAL_MS=3600000

# --- Admin API (separate, authenticated port) ---
# Bearer token required by the admin API. Leave unset to disable the admin port.
# Never expose the admin port publicly: it surfaces account addresses and scope.
ADMIN_TOKEN=
ADMIN_PORT=51235
# Optional block-explorer base URL. When set, the operator dashboard links
# transaction hashes (/transactions/), ledgers (/ledgers/), and MPT ids (/mpt/)
# to it. Example (testnet): https://testnet.xrpl.org
EXPLORER_BASE_URL=

# --- Concurrency governor (global, shared across all issuances) ---
# Cap on in-flight upstream requests.
GOVERNOR_MAX_CONCURRENT=4
# First backoff step when upstream sheds load, in milliseconds.
GOVERNOR_MIN_BACKOFF_MS=1000
# Backoff ceiling, in milliseconds.
GOVERNOR_MAX_BACKOFF_MS=60000
# Exponential growth factor between consecutive load signals.
GOVERNOR_BACKOFF_FACTOR=2
