# Copy to deploy/docker/.env and edit. Read by `docker compose` both for the
# ${…} substitutions in compose.yml and as the registrar container's environment.
# Never commit the real file (it is gitignored).

# --- Upstream Clio (required) ---
# WebSocket URL of a FULL-HISTORY Clio server (tail + forwarding).
CLIO_ENDPOINT=wss://your-full-history-clio.example
# Optional HTTP JSON-RPC endpoint for the heavy paged account_tx backfill (ADR-016).
#CLIO_HTTP_ENDPOINT=https://your-full-history-clio.example:51234/

# --- Postgres (the compose stack's own server) ---
# Used for the postgres service AND composed into the registrar's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# --- Admin API + dashboard ---
# Bearer token; generate with `openssl rand -hex 32`. Required — without it the
# admin port is disabled and nothing can be registered.
ADMIN_TOKEN=
# Set true once the dashboard is served over HTTPS by your proxy (ADR-019).
ADMIN_SECURE_COOKIE=false
# Optional block-explorer base URL for dashboard links, e.g. https://livenet.xrpl.org
#EXPLORER_BASE_URL=

# --- Host exposure (compose only; the app never sees these) ---
# Where the two ports are published ON THE HOST. Default loopback = private.
# A LAN address or 0.0.0.0 opens them to the network — see compose.yml.
#BIND_ADDRESS=127.0.0.1
#PUBLISH_READ_PORT=51234
#PUBLISH_ADMIN_PORT=51235

# --- Tuning (defaults are fine) ---
#REDISCOVERY_INTERVAL_MS=3600000
#GOVERNOR_MAX_CONCURRENT=4
#CLIO_MAX_RETRIES=5
#CLIO_REQUEST_TIMEOUT_MS=30000

# Do NOT set HOST, ADMIN_HOST, PORT, ADMIN_PORT, STORAGE_ENGINE, DATABASE_URL or
# DATABASE_DIR here: the image and compose.yml own those.
