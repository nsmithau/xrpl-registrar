# xrpl-registrar service configuration.
#
# The installer copies this to /etc/xrpl-registrar/xrpl-registrar.env (mode 0600,
# owned by the service user). Edit that file, then `systemctl restart
# xrpl-registrar`. This is a systemd EnvironmentFile: one KEY=value per line, no
# quotes, no shell expansion, `#` for comments.

# --- Upstream Clio (required) ---
# WebSocket URL of a FULL-HISTORY Clio server. No default: a missing or wrong
# source is a startup error, never a silent fallback.
CLIO_ENDPOINT=wss://your-full-history-clio.example

# Optional: Clio HTTP JSON-RPC endpoint. When set, the heavy paged account_tx
# backfill/heal workload uses it — a connection pool parallelises far better than
# the single WebSocket socket (ADR-016). The subscribe tail and forwarding stay
# on CLIO_ENDPOINT. Leave unset to run everything over WebSocket.
# CLIO_HTTP_ENDPOINT=https://your-full-history-clio.example:51234/

CLIO_MAX_RETRIES=5
CLIO_CONNECTION_TIMEOUT_MS=20000
CLIO_REQUEST_TIMEOUT_MS=30000

# --- Storage ---
# Absolute path to the embedded database directory. MUST be an absolute path the
# service user can write (the systemd unit grants /var/lib/xrpl-registrar). A
# persistent archive MUST set this — an unset value is an ephemeral in-memory DB.
DATABASE_DIR=/var/lib/xrpl-registrar

# --- Public read API ---
# Port for the Clio-compatible read API (WebSocket + HTTP JSON-RPC).
PORT=51234
# Bind address for the PUBLIC read API. Default (loopback) is the secure posture:
# front it with the nginx reverse proxy in deploy/nginx/ to terminate TLS. Set to
# 0.0.0.0 to expose it directly — only behind a firewall, and never with TLS off.
HOST=127.0.0.1
# Safety-net full re-scan interval, in ms. Streaming discovery is primary; this
# only backstops holders missed during a tail gap. 0 disables it. Default 1 hour.
REDISCOVERY_INTERVAL_MS=3600000

# --- Admin API (authenticated; always bound to loopback) ---
# Bearer token required by the admin API and the operator dashboard. Leave unset
# to disable the admin port entirely. Generate a strong value, e.g.:
#   openssl rand -hex 32
# The admin port is ALWAYS bound to 127.0.0.1 — reach it via an SSH tunnel, never
# a public proxy (ADR-009).
ADMIN_TOKEN=
ADMIN_PORT=51235
# Optional block-explorer base URL. When set, the dashboard links transaction
# hashes, ledgers, MPT ids, and IOU tokens to it. Example: https://livenet.xrpl.org
EXPLORER_BASE_URL=

# --- Concurrency governor (global, shared across all issuances) ---
GOVERNOR_MAX_CONCURRENT=4
GOVERNOR_MIN_BACKOFF_MS=1000
GOVERNOR_MAX_BACKOFF_MS=60000
GOVERNOR_BACKOFF_FACTOR=2
